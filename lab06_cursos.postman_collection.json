      "name": "1. Consultas (GET)",
      "item": [
        {
          "name": "Listar todos los cursos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde con codigo 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Devuelve un arreglo de cursos\", function () {",
                  "    pm.expect(pm.response.json().data).to.be.an(\"array\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/cursos",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "cursos"
              ]
            }
          }
        },
        {
          "name": "Filtrar por creditos = 4",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde con codigo 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Todos los cursos tienen 4 creditos\", function () {",
                  "    pm.response.json().data.forEach(function (c) {",
                  "        pm.expect(c.creditos).to.eql(4);",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/cursos?creditos=4",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "cursos"
              ],
              "query": [
                {
                  "key": "creditos",
                  "value": "4"
                }
              ]
            }
          }
        },
